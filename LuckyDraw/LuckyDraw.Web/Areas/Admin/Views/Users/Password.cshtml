@model UserPasswordModel
@{
    ViewData["Title"] = L["Đổi mật khẩu"];
}
<div class="page-head">
    <div>
        <div class="crumb"><a asp-action="Index">@L["Tài khoản"]</a> / @Model.UserName</div>
        <h1>@ViewData["Title"]: <span class="mono">@Model.UserName</span></h1>
    </div>
</div>
<div class="row g-3">
    <div class="col-xl-7">
<form method="post" asp-action="Password" asp-route-id="@Model.UserId" class="card-ld" novalidate>
    <div class="form-section">
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password"></span>
        </div>
        <div>
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>
    </div>
    <div class="form-foot">
        <a class="btn btn-light" asp-action="Index">@L["Huỷ"]</a>
        <button type="submit" class="btn btn-primary">@Html.Icon("key") @L["Đổi mật khẩu"]</button>
    </div>
</form>
    </div>
    <div class="col-xl-5"><partial name="_UserSide" /></div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
